{
    "name": "@nera-static/nera",
    "version": "1.30.0",
    "description": "The Nera CLI — scaffold, build, preview and update a Nera static site with one command over the @nera-static/core engine",
    "type": "module",
    "exports": {
        ".": "./src/index.js",
        "./package.json": "./package.json"
    },
    "bin": {
        "nera": "bin/nera.js"
    },
    "scripts": {
        "lint": "nera-stan",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare": "husky"
    },
    "files": [
        "bin",
        "skills",
        "src",
        "template",
        "CHANGELOG.md"
    ],
    "keywords": [
        "nera",
        "static-site-generator",
        "cli",
        "scaffolding",
        "ssg",
        "jamstack"
    ],
    "author": "Michael Becker",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/seebaermichi/nera-cli.git"
    },
    "bugs": {
        "url": "https://github.com/seebaermichi/nera-cli/issues"
    },
    "homepage": "https://github.com/seebaermichi/nera-cli#readme",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "@nera-static/core": "^4.12.0",
        "@nera-static/plugin-utils": "^1.9.0",
        "@nera-static/validate": "^1.9.0",
        "@noble/ciphers": "^2.4.0",
        "@noble/curves": "^2.4.0",
        "@noble/hashes": "^2.4.0",
        "chokidar": "^5.0.0",
        "ignore": "^7.0.12",
        "semver": "^7.8.5",
        "vite": "^8.1.5",
        "yaml": "^2.9.1"
    },
    "optionalDependencies": {
        "@napi-rs/keyring": "^2.1.2"
    },
    "devDependencies": {
        "@nera-static/stan": "^1.1.0",
        "@nera-static/test-utils": "^1.0.2",
        "husky": "^9.1.7",
        "vitest": "^5.0.3"
    },
    "nera-stan": {
        "ignores": [
            "test/cold-agent/2026-10-10-baseline/"
        ],
        "variants": {
            ".github/dependabot.yml": "chokidar-major"
        },
        "skip": {
            "@stylistic/max-len": "until step 8 of issue 01a21e37-be04-7039-9fe6-50fc5bd7d327: the long lines in bin/, src/ and test/ are wrapped (steps 2, 6 and 8)"
        }
    }
}
